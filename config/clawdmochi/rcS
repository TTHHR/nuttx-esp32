
set +e

mkdir -p /data
mkdir -p /data/bin
mkdir -p /data/scripts

if [ -d /data ]; then
    echo "[OK]    /data"
else
    echo "[ERROR] /data"
fi

if [ -d /data/bin ]; then
    echo "[OK]    /data/bin"
else
    echo "[ERROR] /data/bin"
fi

if [ -d /data/scripts ]; then
    echo "[OK]    /data/scripts"
else
    echo "[ERROR] /data/scripts"
fi

ifconfig

if [ -e /data/net.nsh ]; then
    echo "[OK]    /data/net.nsh"
    source /data/net.nsh
else
    echo ifup wlan0 >> /data/net.nsh
    echo  wapi txpower wlan0 8 WAPI_TXPOWER_DBM >> /data/net.nsh
    echo wapi psk wlan0 invo@123456 3   >> /data/net.nsh
    echo wapi essid wlan0 invo-lan 1  >> /data/net.nsh
    echo renew wlan0 >> /data/net.nsh

fi

set -e
